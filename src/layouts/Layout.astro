---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Devansh Agarwal builds AI systems that scale: large-scale model training, agentic systems, and scientific machine learning.',
  canonical = Astro.url.pathname,
  noindex = false,
} = Astro.props;
const pageTitle = title === 'Devansh Agarwal' ? `${title} — AI systems that scale` : `${title} — Devansh Agarwal`;
const canonicalUrl = new URL(canonical, Astro.site);
const navigation = [
  { href: '/', label: 'Home' },
  { href: '/work/', label: 'Work' },
  { href: '/publications/', label: 'Publications' },
  { href: '/about/', label: 'About' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f8f2" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header container">
      <a class="identity" href="/" aria-label="Devansh Agarwal, home">
        <span class="identity-name">Devansh Agarwal</span>
      </a>
      <nav class="site-nav" aria-label="Main navigation">
        {navigation.map(({ href, label }) => (
          <a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
      <a class="header-contact" href="https://www.linkedin.com/in/devanshkv/">LinkedIn <span aria-hidden="true">↗</span></a>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer container">
      <div class="footer-bottom">
        <span>© {new Date().getUTCFullYear()} Devansh Agarwal</span>
        <nav class="footer-links" aria-label="Other profiles">
          <a href="https://github.com/devanshkv">GitHub <span aria-hidden="true">↗</span></a>
          <a href="https://www.linkedin.com/in/devanshkv/">LinkedIn <span aria-hidden="true">↗</span></a>
          <a href="https://scholar.google.com/citations?user=C9n7eNEAAAAJ">Google Scholar <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </footer>
  </body>
</html>
